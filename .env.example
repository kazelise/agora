# 本地 OpenAI 兼容中继的占位密钥，任意非空即可
OPENAI_API_KEY=relay-no-key
# 中继的 OpenAI-compatible 根路径（含 /v1）
OPENAI_BASE_URL=http://192.168.1.100:8317/v1
# langchain 也会读这个，值和 OPENAI_BASE_URL 保持一致
OPENAI_API_BASE=http://192.168.1.100:8317/v1
# triage 用的小模型
AGORA_SMALL_MODEL=gpt-5.6-luna
# 工具循环用的大模型
AGORA_BIG_MODEL=gpt-5.6-terra
# Postgres（compose 把主机端口映到 5433）
AGORA_DATABASE_URL=postgresql://agora:agora@127.0.0.1:5433/agora
# Redis
AGORA_REDIS_URL=redis://127.0.0.1:6379/0
